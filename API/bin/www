#!/usr/bin/env node

var app = require('../app');
var debug = require('debug')('jwt-auth-express-mysql:server');
var http = require('http');
var os = require('os');

var port = normalizePort(process.env.PORT || '8080');
app.set('port', port);

var server = http.createServer(app);

server.listen(port, '0.0.0.0', function() {
  var localIP = getLocalIPAddress();
  var interfaces = os.networkInterfaces();
  var allIPs = [];
  
  for (var devName in interfaces) {
    var iface = interfaces[devName];
    for (var i = 0; i < iface.length; i++) {
      var alias = iface[i];
      if (alias.family === 'IPv4' && alias.address !== '127.0.0.1' && !alias.internal) {
        allIPs.push({name: devName, ip: alias.address});
      }
    }
  }
  
  console.log(`Server is running on port ${port} and listening on all interfaces (0.0.0.0).`);
  console.log(`Access the API at: http://localhost:${port}`);
  console.log(`From mobile devices on the same network, try one of these IPs:`);
  console.log(`  Recommended: http://${localIP}:${port}`);
  if (allIPs.length > 1) {
    console.log(`  All available IPs:`);
    allIPs.forEach(function(item) {
      console.log(`    - http://${item.ip}:${port} (${item.name})`);
    });
  }
});
server.on('error', onError);
server.on('listening', onListening);

// Détecte l'adresse IP locale pour permettre l'accès depuis des appareils mobiles
// sur le même réseau. Ignore les interfaces virtuelles (VirtualBox, VMware, etc.)
function getLocalIPAddress() {
  var interfaces = os.networkInterfaces();
  var wifiIP = null;
  var otherIPs = [];
  
  for (var devName in interfaces) {
    var iface = interfaces[devName];
    // Ignore les interfaces réseau virtuelles qui ne sont pas utiles pour l'accès mobile
    if (devName.includes('VirtualBox') || devName.includes('VMware') || 
        devName.includes('TAP') || devName.includes('vEthernet')) {
      continue;
    }
    
    for (var i = 0; i < iface.length; i++) {
      var alias = iface[i];
      // Recherche uniquement les adresses IPv4 non-localhost et non-internes
      if (alias.family === 'IPv4' && alias.address !== '127.0.0.1' && !alias.internal) {
        // Priorise les adresses dans le réseau 192.168.86.x (réseau Google Nest)
        if (alias.address.startsWith('192.168.86.')) {
          if (!wifiIP) {
            wifiIP = alias.address;
          }
        } else {
          wifiIP = alias.address;
          break;
        }
        otherIPs.push({name: devName, ip: alias.address});
      }
    }
  }
  
  if (wifiIP) {
    return wifiIP;
  }
  
  if (otherIPs.length > 0) {
    return otherIPs[0].ip;
  }
  
  return 'localhost';
}

// Normalise le port depuis une variable d'environnement ou une chaîne
// Retourne le port en entier si valide, sinon retourne la valeur originale ou false
function normalizePort(val) {
  var port = parseInt(val, 10);

  if (isNaN(port)) {
    return val;
  }

  if (port >= 0) {
    return port;
  }

  return false;
}

function onError(error) {
  if (error.syscall !== 'listen') {
    throw error;
  }

  var bind = typeof port === 'string'
    ? 'Pipe ' + port
    : 'Port ' + port;

  switch (error.code) {
    case 'EACCES':
      console.error(bind + ' requires elevated privileges');
      process.exit(1);
      break;
    case 'EADDRINUSE':
      console.error(bind + ' is already in use');
      process.exit(1);
      break;
    default:
      throw error;
  }
}

function onListening() {
  var addr = server.address();
  var bind = typeof addr === 'string'
    ? 'pipe ' + addr
    : 'port ' + addr.port;
  debug('Listening on ' + bind);
}
